                            - description: Tache de création d'un agent pour la direction concernee
                            - type: formulaire
                            - delai_jour: null
                            - contenu: [
                                champs: [{
                                id:"fonction",
                                - type:"texte",
                                - label:"Fonction de l'agent",
                                - description:"Fonction de l'agent",
