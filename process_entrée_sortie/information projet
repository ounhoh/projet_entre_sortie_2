        - status_list: (trié par ordre)
            - statut:
                - id : générée
                - code_statut: statut_entree_agent_1
                - lib_statut: Initialisation
                - description: étape du formulaire de création d'un agent pour remplir ses informations personnelles
            - statut:
                - id : générée
