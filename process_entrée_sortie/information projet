                              champs: [{
                                - id:"nom_agent",
                                - type:"texte",
                                - label:"Nom de l'agent",
                                - description:"Nom de l'agent",
                                - required:true,
                                - validation: {
                                    "minLenght":1,
                                    "maxLength": 100,
                                }
                                },
                                {
                                id:"prenom_agent",
                                type:"texte",
                                - label:"Prenom de l'agent",
                                - description:"Prenom de l'agent",
                                - required:true,
                                - validation: {
                                    "minLenght":1,
                                    "maxLength": 100,
                                }
                                },
                                {
                                - id:"email_agent",
                                - type:"email",
                                - label:"Email de l'agent",
                                - description:"Email de l'agent",
                                - required:true,
                                - validation: {
                                    "minLenght":1,
                                    "maxLength": 100,
                                    "pattern": "^[a-zA-Z0-9._%+-]+@lecese\\.fr$",
                                }
                                },
                                {
                                id:"date_arrivee",
                                type:"date",
                                - label:"Date d'arrivée de l'agent",
                                - description:"Date d'arrivée de l'agent",
                                - required:true,
                                - default: LocalDate.now(),
                                - validation: {
                                    "minDate": LocalDate.now(),
                                }
                                },
                                {
                                id:"date_depart",
                                type:"date",
                                - label:"Date de départ de l'agent",
                                - description:"Date de départ de l'agent",
                                - required:false,
                                - default: null,
                                - validation: {
                                    "minDate": LocalDate.now(),
                                }
                                },
                                {
                                id:"direction",
                                type:"select",
                                - label:"Direction de l'agent",
                                - description:"Direction de l'agent",
                                - required:true,
                                - options: {
                                    accesBaseDonnees: "direction",
                                    champs: ["lib_direction", "code_direction"]
                                }
                                },
                                {
                                    id:"image_agent",
                                    type:"image",
                                    - label:"Image de l'agent",
                                    - description:"Image de l'agent",
                                    - required:true,
                                    - default: null,
                                    - validation: {
                                        "minSize": 100,
                                        "maxSize": 1000000,
                                        "mimeType": ["image/jpeg", "image/png", "image/gif", "image/webp"],
                                    }
                                    }
                                },
                                },
                                {
                                id:"role",
                                - type:"select",
                                - label:"Role de l'agent",
                                - description:"Role de l'agent",
                                - required:true,
                                - options: {
                                    accesBaseDonnees: "role",
                                    champs: ["lib_role", "code_role"]
                                }
                                }]
                                actions: [
                                    {
                                        type: "UPDATE_AGENT",
                                        condition: null,
                                        params: {
                                            nom: "${formulaire.nom_agent}",
                                            prenom: "${formulaire.prenom_agent}",
                                            email: "${formulaire.email_agent}",
                                            role: "${formulaire.role}",
                                            etatAgent: "${templasus.typeProcessus}"
                                        }
                                },
                                {
                                    type: "UPDATE_AGENT_DIRECTION",
                                    condition: null,
                                    params: {
                                        agentId: "${agent.id}",
                                        directionId: "${formulaire.direction}",
                                        dateArrivee: "${formulaire.date_arrivee}"
                                    }
                                },
                                ]
                        ]
                - templategroupe_tache:
                    - id: générée 
                    - code_groupe_tache: agent_form_concenrnee
                    - lib_groupe_tache: Groupe de taches de création d'un agent
                    - description: Groupe de taches de création d'un agent
                    - statut_processus: Formulaire des droits
                    - isDirectionConcernee: true
                    - template_processus: entrée_agent
                    - template_tache_list:
